# mean TP concentration in during retention
month_df_counts %>% filter(ret_rel_tp == 0) %>% summarise(mean_tp = mean(tp_in_mgL, na.rm = T), sd_tp = sd(tp_in_mgL, na.rm = T), max_tp = max(tp_in_mgL, na.rm = T), min_tp = min(tp_in_mgL, na.rm = T))
# ttest
t.test(tp_in_mgL ~ ret_rel_tp, data = month_df_counts)
# mean TN concentration in during release
month_df_counts %>% filter(ret_rel_tn == 1) %>% summarise(mean_tn = mean(tn_in_mgL, na.rm = T), sd_tp = sd(tn_in_mgL, na.rm = T), max_tn = max(tn_in_mgL, na.rm = T), min_tn = min(tn_in_mgL, na.rm = T))
# mean TN concentration in during retention
month_df_counts %>% filter(ret_rel_tn == 0) %>% summarise(mean_tn = mean(tn_in_mgL, na.rm = T), sd_tp = sd(tn_in_mgL, na.rm = T), max_tn = max(tn_in_mgL, na.rm = T), min_tn = min(tn_in_mgL, na.rm = T))
# ttest
t.test(tn_in_mgL ~ ret_rel_tn, data = month_df_counts)
