# make a combined table
summarize_vals <- function(x) {
mn <- round(min(x, na.rm = TRUE), 0)
mx <- round(max(x, na.rm = TRUE), 0)
data.frame(
mean = round(mean(x, na.rm = TRUE), 0),
median = round(median(x, na.rm = TRUE), 0),
range = paste0(mn, " to ", mx),
quant75 = quantile(x, probs = 0.75, na.rm = TRUE),
quant25 = quantile(x, probs = 0.25, na.rm = TRUE),
quant50 = quantile(x, probs = 0.50, na.rm = TRUE))}
# Retention metrics for all nutrients
tp_filt_all  <- summarize_vals(annual_df$tp_filt_lbs)
tn_filt_all  <- summarize_vals(annual_df$tn_filt_lbs)
drp_filt_all  <- summarize_vals(annual_df$drp_filt_lbs)
nox_filt_all  <- summarize_vals(annual_df$nox_filt_lbs)
nh3_filt_all  <- summarize_vals(annual_df$nh3_filt_lbs)
# Retention in lbs/acre for all nutrients
tp_filt_acre  <- summarize_vals(annual_df$tp_filt_lbs_acre)
tn_filt_acre  <- summarize_vals(annual_df$tn_filt_lbs_acre)
drp_filt_acre  <- summarize_vals(annual_df$drp_filt_lbs_acre)
nox_filt_acre  <- summarize_vals(annual_df$nox_filt_lbs_acre)
nh3_filt_acre  <- summarize_vals(annual_df$nh3_filt_lbs_acre)
# put it all together
exec_sum_table <- data.frame(
Row = c("TP", "TN", "DRP", "NoX","NH3"),
Retention_Mean   = round(c(tp_filt_all$mean, tn_filt_all$mean, drp_filt_all$mean, nox_filt_all$mean, nh3_filt_all$mean), 0),
Retention_Median = round(c(tp_filt_all$median, tn_filt_all$median, drp_filt_all$median, nox_filt_all$median, nh3_filt_all$median), 0),
Retention_Range  = c(tp_filt_all$range, tn_filt_all$range, drp_filt_all$range, nox_filt_all$range, nh3_filt_all$range),
Retention_Mean_lbs_acre   = round(c(tp_filt_acre$mean, tn_filt_acre$mean, drp_filt_acre$mean, nox_filt_acre$mean, nh3_filt_acre$mean), 0),
Retention_Median_lbs_acre = round(c(tp_filt_acre$median, tn_filt_acre$median, drp_filt_acre$median, nox_filt_acre$median, nh3_filt_acre$median), 0),
Retention_Range_lbs_acre  = c(tp_filt_acre$range, tn_filt_acre$range, drp_filt_acre$range, nox_filt_acre$range, nh3_filt_acre$range))
exec_sum_table
month_df=month_df %>%
mutate(habseason = case_when(
month >= 3 & month <= 7 ~ "HAB",
month >= 1 & month <= 2 ~ "Not HAB",
month >= 8 & month <= 12 ~ "Not HAB"))
# summarize the proportion of filtration during HAB season or not
season_HAB_filt = month_df %>%
group_by(Project,habseason)%>%
summarise(tp_filt_lbs = sum(tp_filt_lbs),tn_filt_lbs = sum(tn_filt_lbs),drp_filt_lbs = sum(drp_filt_lbs),nox_filt_lbs = sum(nox_filt_lbs),nh3_filt_lbs = sum(nh3_filt_lbs))
season_HAB_filt = season_HAB_filt %>%
group_by(Project)%>%
mutate(tp_total_season = sum(tp_filt_lbs),tn_total_season = sum(tn_filt_lbs),drp_total_season = sum(drp_filt_lbs),nox_total_season = sum(nox_filt_lbs),nh3_total_season = sum(nh3_filt_lbs))
season_HAB_filt = season_HAB_filt %>%
mutate(tp_prop_season = tp_filt_lbs / tp_total_season,tn_prop_season = tn_filt_lbs / tn_total_season,drp_prop_season = drp_filt_lbs / drp_total_season,nox_prop_season = nox_filt_lbs/nox_total_season,nh3_prop_season = nh3_filt_lbs/nh3_total_season)
prop_season_HAB_filt = season_HAB_filt %>%
group_by(habseason)%>%
summarise(prop_tp_filt = median(tp_prop_season,na.rm=T),prop_tn_filt = median(tn_prop_season,na.rm=T),prop_drp_filt = mean(drp_prop_season,na.rm=T),prop_nox_filt = mean(nox_prop_season,na.rm=T),prop_nh3_filt = mean(nh3_prop_season,na.rm=T))
# how much is TP specifically?
HAB_filt_P = prop_season_HAB_filt %>%  filter(habseason == "HAB") %>%  pull(prop_tp_filt)
annual_df$project_code = annual_df$Project
runoff_df$project_code = runoff_df$name
lbs_acre = annual_df %>%
select(project_code, wateryear, restored_wetland_acres, total_project_acres, tp_filt_lbs_acre, tn_filt_lbs_acre, drp_filt_lbs_acre, nox_filt_lbs_acre, nh3_filt_lbs_acre)
# add in runoff df
runoff_df$project_code = runoff_df$name
runoff_df_sub = runoff_df %>% select(project_code, convertedag, meanrunoff_N, meanrunoff_P)
# merge dfs to get lbs/acre base numbers
lbs_acre = lbs_acre %>%  left_join(runoff_df_sub,   by = c("project_code"))
# calculate lbs/acre for runoff prevention as nutrient runoff lbs / acres converted to agriculture THIS IS ALL THE SAME NUMBER BECAUSE THAT'S HOW WE CALCULATE THIS
lbs_acre = lbs_acre %>%  mutate(tp_runoff_lbs_acre = meanrunoff_P / convertedag, tn_runoff_lbs_acre = meanrunoff_N / convertedag)
# replace NaN with 0
lbs_acre <- lbs_acre %>%  mutate(across(everything(), ~ ifelse(is.nan(.x), 0, .x)))
# filter wetlands
lbs_acre <- lbs_acre %>%  filter(tp_filt_lbs_acre >= 0)
# Retention lbs/acre:
lbs_acre = lbs_acre %>%  mutate(tp_retention_lbs_acre = tp_runoff_lbs_acre + tp_filt_lbs_acre, tn_retention_lbs_acre = tn_runoff_lbs_acre + tn_filt_lbs_acre)
# summary table
per_50 <- quantile(lbs_acre$tp_retention_lbs_acre, probs = 0.50, na.rm = TRUE) * HAB_filt_P
per_75 <- quantile(lbs_acre$tp_retention_lbs_acre, probs = 0.75, na.rm = TRUE) * HAB_filt_P
max_val <- 175 * 0.65
results_table <- data.frame(
Scenario = c("Scenario 1 (50th percentile)","Scenario 2 (75th percentile)",  "Scenario 3 (Maximum)"),
TP_Retention = c(per_50, per_75, max_val),
Acres_Required = c(200000 / per_50, 200000 / per_75,200000 / max_val))
results_table
lbs_acre = annual_df %>%
select(project_code, wateryear, restored_wetland_acres, total_project_acres, tp_filt_lbs_acre, tn_filt_lbs_acre, drp_filt_lbs_acre, nox_filt_lbs_acre, nh3_filt_lbs_acre)
# add in runoff df
runoff_df$project_code = runoff_df$name
runoff_df_sub = runoff_df %>% select(project_code, convertedag, meanrunoff_N, meanrunoff_P)
# merge dfs to get lbs/acre base numbers
lbs_acre = lbs_acre %>%  left_join(runoff_df_sub,   by = c("project_code"))
# calculate lbs/acre for runoff prevention as nutrient runoff lbs / acres converted to agriculture THIS IS ALL THE SAME NUMBER BECAUSE THAT'S HOW WE CALCULATE THIS
lbs_acre = lbs_acre %>%  mutate(tp_runoff_lbs_acre = meanrunoff_P / convertedag, tn_runoff_lbs_acre = meanrunoff_N / convertedag)
# replace NaN with 0
lbs_acre <- lbs_acre %>%  mutate(across(everything(), ~ ifelse(is.nan(.x), 0, .x)))
# Retention lbs/acre:
lbs_acre = lbs_acre %>%  mutate(tp_retention_lbs_acre = tp_runoff_lbs_acre + tp_filt_lbs_acre, tn_retention_lbs_acre = tn_runoff_lbs_acre + tn_filt_lbs_acre)
# summary table
per_50 <- quantile(lbs_acre$tp_retention_lbs_acre, probs = 0.50, na.rm = TRUE) * HAB_filt_P
per_75 <- quantile(lbs_acre$tp_retention_lbs_acre, probs = 0.77, na.rm = TRUE) * HAB_filt_P
max_val <- 175 * 0.65
results_table <- data.frame(
Scenario = c("Scenario 1 (50th percentile)","Scenario 2 (75th percentile)",  "Scenario 3 (Maximum)"),
TP_Retention = c(per_50, per_75, max_val),
Acres_Required = c(200000 / per_50, 200000 / per_75,200000 / max_val))
results_table
loo_plots <- function(results, nutrient) {
p_model <- ggplot(results, aes(x = project, y = rmse_model)) +
geom_bar(stat = "identity") +
theme_bw() +
theme(axis.text.x = element_text(angle = 90)) +
ylab(paste("RMSE of model with site removed (log", nutrient, "Retention (lbs))")) +
xlab("Project Code")
p_removed <- ggplot(results, aes(x = project, y = rmse_removed)) +
geom_bar(stat = "identity") +
theme_bw() +
theme(axis.text.x = element_text(angle = 90)) +
ylab(paste("RMSE of model on removed site (log", nutrient, "Retention (lbs))")) +
xlab("Project Code")
list(model = p_model, removed = p_removed)
}
tp_plots  <- loo_plots(tp_results,  "TP")
tn_plots  <- loo_plots(tn_results,  "TN")
drp_plots <- loo_plots(drp_results, "DRP")
nox_plots <- loo_plots(nox_results, "NOx")
nh3_plots <- loo_plots(nh3_results, "NH3")
figure_s1 <- ((tp_plots$model + tp_plots$removed) /
(tn_plots$model + tn_plots$removed) /
(nox_plots$model + nox_plots$removed) /
(drp_plots$model + drp_plots$removed) /
(nh3_plots$model + nh3_plots$removed)) +
plot_annotation(title = "Leave-One-Site-Out RMSE Results", subtitle = "Model RMSE and Removed Site RMSE by Nutrient")
figure_s1
figure_s1 <- ((tp_plots$model + tp_plots$removed) /
figure_s1 <- ((tp_plots$model + tp_plots$removed) /
(tn_plots$model + tn_plots$removed) +  plot_annotation(title = "Leave-One-Site-Out RMSE Results", subtitle = "Model RMSE and Removed Site RMSE by Nutrient"))
