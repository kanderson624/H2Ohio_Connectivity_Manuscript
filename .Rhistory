# TO ASK DAVE: SHOULD I DO MEDIAN FOR ALL WETLANDS OR JUST REMOVED WETLAND?
# does percent accurately describe the variance here... It's not a linear relationship between error and the median... there's more error with lower numbers. Want to account for that. The error is accurately ~ 3 lbs, more accurate at higher retention values than lower
tp_results <- tp_results %>%
mutate(rmse_percent_all = (10^rmse_model) / (10^median_all))%>%
mutate(rmse_percent_remove = (10^rmse_removed) / (10^median_all))%>%
mutate(rmse_model_unlog = 10^rmse_model)%>%
mutate(rmse_removed_unlog = 10^rmse_removed)
tp_results
10^0.330621
