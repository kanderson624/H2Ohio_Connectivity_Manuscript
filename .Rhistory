library(nhdplusTools) # get river lines
# Download Ohio state boundary
ohio_sf <- states(cb = TRUE) |>
subset(NAME == "Ohio")
tile_bbox <- st_as_sfc(st_bbox(ohio_sf, crs = st_crs(4326)))
# that used ggmap/get_map instead of maptiles library
tile <- get_tiles(tile_bbox, provider = "Esri.WorldGrayCanvas", zoom = 10)
# Fetch all US county spatial data
ohio_counties <- counties(state = "OH", cb = TRUE, class = "sf")
# that flattens the earth properly for Ohio (e.g., Ohio North/South 3734/3735)
ohio_counties_projected <- st_transform(ohio_counties, crs = 4326)
# Download Ohio flowlines
ohio_rivers <- download_nhdplushr(ohio_sf,layer = "NHDFlowline")
flowlines <- nhdplusTools::get_nhdplushr(
plot_extent,
realization = "flowline"
)
