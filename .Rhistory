get_project_model_stats <- function(df,
response_var,
concentration_var,
volume_var = "inflow_volume_m3") {
# Replace NAs in concentration variable with 0
df <- df %>%
mutate(
!!concentration_var := coalesce(.data[[concentration_var]], 0)
)
df %>%
group_by(Project) %>%
group_modify(~{
form <- as.formula(
paste(response_var, "~", volume_var, "+", concentration_var)
)
mod <- lm(form, data = .x)
coefs <- summary(mod)$coefficients
tibble(
n = nrow(.x),
r2 = summary(mod)$r.squared,
inflow_volume_t =
if (volume_var %in% rownames(coefs))
coefs[volume_var, "t value"]
else NA_real_,
concentration_t =
if (concentration_var %in% rownames(coefs))
coefs[concentration_var, "t value"]
else NA_real_
)
}) %>%
ungroup()
}
tp_stats <- get_project_model_stats(
month_df_tp_filt,
response_var = "tp_filt_lbs",
concentration_var = "tp_in_mgL"
)
